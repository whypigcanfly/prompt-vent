{
  "schema_version": 1,
  "plugin_version": "0.1.0",
  "default_mode": "激励师",
  "modes": ["渣女", "激励师", "贴吧老哥", "off"],
  "scoring": {
    "weights": {
      "intent": 0.30,
      "specificity": 0.25,
      "structure": 0.25,
      "robustness": 0.20
    },
    "short_penalty_enabled": true,
    "whitelist_floor": 7.0
  },
  "dedup": {
    "threshold": 0.85,
    "short_strict_len": 20,
    "long_relax_len": 50
  },
  "update": {
    "max_per_update": 20,
    "max_per_day": 10,
    "timeout_sec": 15,
    "retry": 1
  },
  "storage": {
    "mode": "json",
    "path": "~/.ci-pj/state.json",
    "speech_path": "~/.ci-pj/speech.user.json"
  },
  "log": {
    "level": "INFO",
    "retention_days": 7,
    "dir": "~/.ci-pj/log"
  },
  "safety": {
    "enabled": true,
    "blocklist": [],
    "note": "默认空列表，仅作占位；违规判定建议接入宿主 Agent 的安全层，本插件只做轻量关键词拦截兜底。"
  },
  "command_prefix": "/pj-",
  "hook": {
    "lead_output": true,
    "lead_output_instruction": "[词趣判官·输出要求] 请把上方第一行以「【」开头的评判行，原样作为你本次回复的第一行输出；随后空一行，再开始你的思考与正式回答。不要改写、不要省略、不要加引号，也不要把本条要求本身说出来。",
    "note": "lead_output=true 时，ci-pj hook 会在评判结果后追加一条给宿主 Agent 的输出指令，使评判出现在回复首行；设为 false 则只输出评判块本身（装饰性注入）。"
  }
}
